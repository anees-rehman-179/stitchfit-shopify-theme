<article class="sf-lookbook-page">
  {%- comment -%} Hero {%- endcomment -%}
  <div class="sf-lookbook-page__hero" data-sf-reveal>
    {%- if section.settings.hero_image -%}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
        alt=""
        loading="eager">
    {%- else -%}
      {% render 'sf-placeholder', label: 'LOOKBOOK-HERO  ·  16:9', ratio: '16/9' %}
    {%- endif -%}
    <div class="sf-lookbook-page__hero-overlay">
      <div class="sf-eyebrow sf-eyebrow--light">{{ section.settings.hero_eyebrow | default: 'Lookbook' }}</div>
      <h1>{{ section.settings.hero_heading | default: 'How it wears.' }}</h1>
    </div>
  </div>

  {%- comment -%} Intro band {%- endcomment -%}
  {%- if section.settings.intro != blank -%}
    <div class="sf-lookbook-page__intro" data-sf-reveal>
      <p>{{ section.settings.intro | default: 'Quiet pieces, built for everyday wear. Photographed on real men, in the streets where this knitwear belongs.' }}</p>
    </div>
  {%- endif -%}

  {%- comment -%} Bento grid (reuses sf-lookbook classes for visual parity) {%- endcomment -%}
  <div class="sf-lookbook sf-lookbook--page">
    <div class="sf-lookbook__grid">
      {%- for tile_index in (1..6) -%}
        {%- assign image_key = 'image_' | append: tile_index -%}
        {%- assign tile_image = section.settings[image_key] -%}
        <div class="sf-lookbook__tile sf-lookbook__tile--{{ tile_index }}" data-sf-reveal>
          {%- if tile_image -%}
            <img
              src="{{ tile_image | image_url: width: 1200 }}"
              width="{{ tile_image.width }}"
              height="{{ tile_image.height }}"
              loading="lazy"
              alt="">
          {%- else -%}
            {%- assign tile_label = 'LOOKBOOK-' | append: tile_index -%}
            {% render 'sf-placeholder', label: tile_label, ratio: '3/4' %}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Outfit stories — 3 cards under the bento {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="sf-lookbook-page__outfits" data-sf-reveal>
      <div class="sf-lookbook-page__outfits-head">
        <div class="sf-eyebrow">{{ section.settings.outfits_eyebrow | default: 'The outfits' }}</div>
        <h2>{{ section.settings.outfits_heading | default: 'Three ways to wear it.' }}</h2>
      </div>
      <div class="sf-lookbook-page__outfits-grid" data-sf-stagger>
        {%- for block in section.blocks -%}
          <article class="sf-lookbook-outfit" data-sf-reveal data-sf-delay="{{ forloop.index0 | times: 120 }}" {{ block.shopify_attributes }}>
            <div class="sf-lookbook-outfit__media">
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  alt="">
              {%- else -%}
                {%- assign outfit_label = 'LOOKBOOK-OUTFIT-' | append: forloop.index -%}
                {% render 'sf-placeholder', label: outfit_label, ratio: '4/5' %}
              {%- endif -%}
            </div>
            <div class="sf-lookbook-outfit__copy">
              <h3 class="sf-lookbook-outfit__title">{{ block.settings.name | default: 'Outfit name' }}</h3>
              <p class="sf-lookbook-outfit__body">{{ block.settings.body | default: 'A short line about the look — fabric, mood, where it belongs.' }}</p>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="sf-lookbook-outfit__link">
                  {{ block.settings.link_label | default: 'Shop the look' }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Pull-quote strip {%- endcomment -%}
  {%- if section.settings.pullquote != blank -%}
    <div class="sf-strip" data-sf-reveal>
      <p class="sf-strip__quote">{{ section.settings.pullquote }}</p>
    </div>
  {%- endif -%}
</article>

{% stylesheet %}
  .sf-lookbook-page { background: var(--sf-base); }

  /* Hero */
  .sf-lookbook-page__hero {
    position: relative;
    height: 70vh;
    min-height: 480px;
    overflow: hidden;
  }
  .sf-lookbook-page__hero img,
  .sf-lookbook-page__hero .sf-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  .sf-lookbook-page__hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(26, 31, 27, 0.45);
    text-align: center;
    padding: 24px;
  }
  .sf-lookbook-page__hero-overlay .sf-eyebrow--light {
    margin-bottom: 16px;
  }
  .sf-lookbook-page__hero-overlay h1 {
    font-family: var(--sf-font-display);
    font-weight: 300;
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: 0.06em;
    color: var(--sf-base);
    margin: 0;
  }

  /* Intro */
  .sf-lookbook-page__intro {
    max-width: 720px;
    margin: 0 auto;
    padding: 96px 32px 32px;
    text-align: center;
  }
  .sf-lookbook-page__intro p {
    font-family: var(--sf-font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--sf-text);
    margin: 0;
  }

  /* Tighten lookbook grid spacing on this page */
  .sf-lookbook--page { padding-top: 32px; padding-bottom: 96px; }

  /* Outfit stories */
  .sf-lookbook-page__outfits {
    padding: 96px 64px;
    background: var(--sf-paper);
  }
  .sf-lookbook-page__outfits-head {
    text-align: center;
    margin-bottom: 64px;
  }
  .sf-lookbook-page__outfits-head h2 {
    font-family: var(--sf-font-display);
    font-weight: 300;
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: 0.04em;
    margin: 16px 0 0;
  }
  .sf-lookbook-page__outfits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .sf-lookbook-outfit__media {
    aspect-ratio: 4 / 5;
    border-radius: var(--sf-radius-card);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .sf-lookbook-outfit__media img,
  .sf-lookbook-outfit__media .sf-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .sf-lookbook-outfit__title {
    font-family: var(--sf-font-display);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 24px);
    letter-spacing: 0.04em;
    margin: 0 0 8px;
  }
  .sf-lookbook-outfit__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--sf-text);
    margin: 0 0 16px;
    opacity: 0.8;
  }
  .sf-lookbook-outfit__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sf-accent);
    text-decoration: none;
    transition: gap 200ms var(--sf-ease);
  }
  .sf-lookbook-outfit__link:hover { gap: 12px; }
  .sf-lookbook-outfit__link span { transition: transform 200ms var(--sf-ease); }
  .sf-lookbook-outfit__link:hover span { transform: translateX(4px); }

  @media (max-width: 900px) {
    .sf-lookbook-page__outfits-grid { grid-template-columns: 1fr; gap: 48px; }
    .sf-lookbook-page__outfits { padding: 64px 24px; }
  }
  @media (max-width: 600px) {
    .sf-lookbook-page__hero { height: 60vh; min-height: 380px; }
    .sf-lookbook-page__intro { padding: 64px 20px 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF Lookbook Page",
  "tag": "section",
  "class": "sf-lookbook-page-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Lookbook" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "How it wears." },

    { "type": "header", "content": "Intro" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Quiet pieces, built for everyday wear. Photographed on real men, in the streets where this knitwear belongs." },

    { "type": "header", "content": "Bento tiles" },
    { "type": "image_picker", "id": "image_1", "label": "Tile 1 (large, top-left)" },
    { "type": "image_picker", "id": "image_2", "label": "Tile 2" },
    { "type": "image_picker", "id": "image_3", "label": "Tile 3 (tall)" },
    { "type": "image_picker", "id": "image_4", "label": "Tile 4" },
    { "type": "image_picker", "id": "image_5", "label": "Tile 5 (wide)" },
    { "type": "image_picker", "id": "image_6", "label": "Tile 6" },

    { "type": "header", "content": "Outfit stories" },
    { "type": "text", "id": "outfits_eyebrow", "label": "Eyebrow", "default": "The outfits" },
    { "type": "text", "id": "outfits_heading", "label": "Heading", "default": "Three ways to wear it." },

    { "type": "header", "content": "Pull-quote (optional)" },
    { "type": "textarea", "id": "pullquote", "label": "Pull-quote", "default": "Wear the vibe." }
  ],
  "blocks": [
    {
      "type": "outfit",
      "name": "Outfit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Outfit name" },
        { "type": "textarea", "id": "body", "label": "Short description" },
        { "type": "url", "id": "link", "label": "Shop link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the look" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SF Lookbook Page",
      "category": "Stitch Fit",
      "blocks": [
        { "type": "outfit", "settings": { "name": "The Office Cardigan", "body": "Soft camel cardigan over a white tee. Knit at true gauge — holds its shape from desk to dinner." } },
        { "type": "outfit", "settings": { "name": "Weekend Polo", "body": "Long-staple cotton polo in deep forest. Looks sharp on its own, layers under a coat for cooler nights." } },
        { "type": "outfit", "settings": { "name": "Winter Sweater", "body": "Heavyweight pullover, hand-linked. Quiet luxury for the cold months — the piece you keep reaching for." } }
      ]
    }
  ]
}
{% endschema %}
