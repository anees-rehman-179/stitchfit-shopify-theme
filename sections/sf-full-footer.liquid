<footer class="sf-footer" role="contentinfo">
  <div class="sf-footer__grid">

    <!-- Col 1: Brand -->
    <div class="sf-footer__brand">
      <a href="{{ routes.root_url }}" class="sf-footer__logo-link" aria-label="{{ shop.name }}">
        <img
          src="{{ 'stitch-fit-logo.jpeg' | asset_url }}"
          alt="{{ shop.name }}"
          width="72"
          height="auto"
          loading="eager"
          class="sf-footer__logo-img">
      </a>
      <p class="sf-footer__tagline"><em>Wear the vibe.</em></p>
      <span class="sf-footer__est">Built in-house since 2009</span>
    </div>

    <!-- Col 2: Shop -->
    <div class="sf-footer__col">
      <h4 class="sf-footer__heading">Shop</h4>
      <ul class="sf-footer__list" role="list">
        <li><a href="/collections/polo-shirts">Polo Shirts</a></li>
        <li><a href="/collections/sweaters-pullovers">Sweaters &amp; Pullovers</a></li>
        <li><a href="/collections/cardigans">Cardigans</a></li>
        <li><a href="/collections/t-shirts-henleys">T-Shirts &amp; Henleys</a></li>
        <li><a href="/collections/all">Shop All</a></li>
      </ul>
    </div>

    <!-- Col 3: Studio -->
    <div class="sf-footer__col">
      <h4 class="sf-footer__heading">Studio</h4>
      <ul class="sf-footer__list" role="list">
        <li><a href="/pages/inside-the-factory">Inside the Factory</a></li>
        <li><a href="/pages/lookbook">Lookbook</a></li>
        <li><a href="/pages/craft-quality">Craft &amp; Quality</a></li>
      </ul>
    </div>

    <!-- Col 4: Help -->
    <div class="sf-footer__col">
      <h4 class="sf-footer__heading">Help</h4>
      <ul class="sf-footer__list" role="list">
        <li><a href="/pages/size-guide">Size Guide</a></li>
        <li><a href="/pages/shipping">Shipping</a></li>
        <li><a href="/pages/returns-exchanges">Returns &amp; Exchanges</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
    </div>

  </div><!-- /sf-footer__grid -->

  <div class="sf-footer__bottom">
    <div class="sf-footer__bottom-inner">
      <p class="sf-footer__address">
        Our factory, Gujranwala, Punjab 52250
      </p>
      <div class="sf-footer__bottom-links">
        <a href="mailto:info@stitchfit.com.pk">info@stitchfit.com.pk</a>
        <a href="https://wa.me/923210900786" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
