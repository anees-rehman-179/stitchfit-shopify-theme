<section class="sf-contact-hero" data-sf-reveal>
  <div class="sf-contact-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        class="sf-contact-hero__img"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high">
    {%- else -%}
      {% render 'sf-placeholder', label: 'CONTACT HERO  2400×1200', ratio: '2/1', kind: 'image' %}
    {%- endif -%}
    <div class="sf-contact-hero__scrim" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="sf-contact-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="sf-eyebrow sf-contact-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h1 class="sf-contact-hero__heading">{{ section.settings.heading | default: 'Get in touch' }}</h1>
    {%- if section.settings.subhead != blank -%}
      <p class="sf-contact-hero__sub">{{ section.settings.subhead }}</p>
    {%- endif -%}

    <div class="sf-contact-hero__chips">
      {%- if section.settings.whatsapp != blank -%}
        {%- assign wa_digits = section.settings.whatsapp | replace: ' ', '' | replace: '+', '' | replace: '-', '' -%}
        <a class="sf-contact-hero__chip" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M20.52 3.48A11.78 11.78 0 0012.06 0C5.46 0 .12 5.34.12 11.94c0 2.1.54 4.15 1.57 5.97L0 24l6.27-1.65a11.93 11.93 0 005.79 1.47h.01c6.6 0 11.94-5.34 11.94-11.94 0-3.19-1.24-6.19-3.49-8.4zM12.07 21.78h-.01a9.83 9.83 0 01-5.01-1.37l-.36-.21-3.72.98.99-3.63-.23-.37a9.81 9.81 0 01-1.5-5.24c0-5.43 4.42-9.85 9.85-9.85 2.63 0 5.1 1.03 6.97 2.89a9.78 9.78 0 012.89 6.97c0 5.43-4.42 9.83-9.87 9.83zm5.4-7.37c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15s-.76.96-.93 1.16c-.17.2-.34.22-.63.07-.3-.15-1.25-.46-2.38-1.47a8.93 8.93 0 01-1.65-2.05c-.17-.3-.02-.46.13-.6.13-.13.3-.34.45-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.18-.24-.57-.49-.5-.66-.51l-.56-.01c-.2 0-.5.07-.76.37s-1 1-1 2.43c0 1.43 1.03 2.81 1.17 3.01.15.2 2.03 3.1 4.92 4.34.69.3 1.22.48 1.64.61.69.22 1.32.19 1.81.12.55-.08 1.71-.7 1.95-1.37.24-.66.24-1.23.17-1.36-.07-.13-.27-.2-.56-.34z"/></svg>
          WhatsApp
        </a>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a class="sf-contact-hero__chip" href="tel:{{ section.settings.phone | replace: ' ', '' }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z"/></svg>
          {{ section.settings.phone }}
        </a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a class="sf-contact-hero__chip" href="mailto:{{ section.settings.email }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {{ section.settings.email }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stitch Fit Contact Hero",
  "tag": "section",
  "class": "sf-contact-hero-section",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Have a question about a product, order, or our process? Reach us through any channel below — we typically reply within one business day." },

    { "type": "header", "content": "Contact channels" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "+92 321 0900786" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+92 321 0900786" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@stitchfit.com.pk" }
  ],
  "presets": [
    { "name": "Stitch Fit Contact Hero", "category": "Stitch Fit" }
  ]
}
{% endschema %}
