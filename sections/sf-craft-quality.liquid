<article class="sf-craft-page" data-sf-reveal>
  {%- comment -%} Hero {%- endcomment -%}
  {%- assign craft_quality_hero_image = section.settings.hero_image -%}
  {%- if craft_quality_hero_image == blank -%}
    {%- assign craft_quality_hero_image = 'craft-quality-top-hero-image.png' | asset_url -%}
  {%- endif -%}
  {%- assign craft_quality_standards_image = section.settings.standards_side_image -%}
  {%- if craft_quality_standards_image == blank -%}
    {%- assign craft_quality_standards_image = 'craft-quality-side-standards-split-screen.jpg' | asset_url -%}
  {%- endif -%}
  {%- assign craft_quality_cta_image = section.settings.cta_bg_image -%}
  {%- if craft_quality_cta_image == blank -%}
    {%- assign craft_quality_cta_image = 'craft-quality-cta-background.png' | asset_url -%}
  {%- endif -%}
  <div class="sf-craft-page__hero{% if section.settings.hero_image %} sf-craft-page__hero--with-image{% endif %}">
    {%- if craft_quality_hero_image != blank -%}
      <img
        class="sf-craft-page__hero-img"
        src="{{ craft_quality_hero_image }}"
        alt=""
        loading="eager">
    {%- endif -%}
    <div class="sf-craft-page__hero-overlay">
      <div class="sf-eyebrow sf-eyebrow--light">{{ section.settings.eyebrow | default: 'Craft & Quality' }}</div>
      <h1>{{ section.settings.hero_heading | default: 'What we put into every piece.' }}</h1>
    </div>
  </div>

  {%- comment -%} Intro statement {%- endcomment -%}
  <div class="sf-craft-page__intro" data-sf-reveal>
    <p>{{ section.settings.intro | default: 'We are a factory first. Every piece we sell carries fifteen years of manufacturing knowledge — the same standards we applied to global brands, now applied to your wardrobe.' }}</p>
  </div>

  {%- comment -%} Three pillars {%- endcomment -%}
  <div class="sf-craft-page__pillars">
    {%- for block in section.blocks -%}
      <div class="sf-craft-pillar" data-sf-reveal data-sf-delay="{{ forloop.index0 | times: 150 }}" {{ block.shopify_attributes }}>
        <div class="sf-craft-pillar__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'yarn' -%}
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                <circle cx="32" cy="32" r="20"/>
                <path d="M17 24c6 5 12 11 20 8"/>
                <path d="M19 38c8-3 14 3 20 8"/>
                <path d="M28 12c0 10 4 20 4 20"/>
              </svg>
            {%- when 'gauge' -%}
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                <circle cx="32" cy="32" r="20"/>
                <path d="M32 16v16l10 7"/>
                <circle cx="32" cy="32" r="2" fill="currentColor" stroke="none"/>
                <path d="M18 44c0-7.73 6.27-14 14-14s14 6.27 14 14" stroke-dasharray="4 3"/>
              </svg>
            {%- when 'hand' -%}
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                <path d="M24 40V24a3 3 0 016 0v10"/>
                <path d="M30 28a3 3 0 016 0v8"/>
                <path d="M36 32a3 3 0 016 0v4l-1 6a8 8 0 01-8 7h-1a8 8 0 01-8-8V36"/>
                <path d="M18 36v-8a3 3 0 016 0"/>
              </svg>
            {%- when 'fibre' -%}
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                <path d="M16 32c0 0 4-12 16-12s16 12 16 12-4 12-16 12S16 32 16 32z"/>
                <circle cx="32" cy="32" r="5"/>
                <path d="M32 20v-6M32 50v-6M20 32h-6M50 32h-6"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
                <circle cx="32" cy="32" r="20"/>
              </svg>
          {%- endcase -%}
        </div>
        <h2 class="sf-craft-pillar__title">{{ block.settings.title }}</h2>
        <p class="sf-craft-pillar__body">{{ block.settings.body }}</p>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Standards section with split-screen layout {%- endcomment -%}
  <div class="sf-craft-page__standards sf-quality" data-sf-reveal>
    <div class="sf-standards-container">
      <div class="sf-standards-text-col">
        <div class="sf-quality__head">
          <div class="sf-eyebrow sf-eyebrow--light">{{ section.settings.standards_eyebrow | default: 'Our Standards' }}</div>
          <h2>{{ section.settings.standards_heading | default: 'Every piece. Every time.' }}</h2>
        </div>
        <div class="sf-craft-page__standards-grid">
          {%- assign standards = section.settings.standards | default: "Long-staple fibres, selected for hand.|Knit at true gauge — your sweater won't stretch out.|Linked by hand, not machine.|Every seam inspected before shipping.|Pre-washed to minimise shrinkage." | split: '|' -%}
          {%- for standard in standards -%}
            <div class="sf-craft-page__standard" data-sf-reveal data-sf-delay="{{ forloop.index0 | times: 80 }}">
              <span class="sf-craft-page__standard-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <p>{{ standard }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if craft_quality_standards_image != blank -%}
        <div class="sf-standards-image-col">
          <picture class="sf-standards-image-wrapper">
            <img
              class="sf-standards-image"
              src="{{ craft_quality_standards_image }}"
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="Standards lookbook"
              loading="lazy"
              width="800"
              height="1000">
          </picture>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} CTA with background image {%- endcomment -%}
  <div class="sf-craft-page__cta" data-sf-reveal{% if craft_quality_cta_image != blank %} style="background-image: url('{{ craft_quality_cta_image }}')"{% endif %}>
    {%- if craft_quality_cta_image != blank -%}
      <div class="sf-craft-page__cta-overlay"></div>
    {%- endif -%}
    <div class="sf-cta-box">
      <h2>{{ section.settings.cta_heading | default: 'Built by the hands that know how.' }}</h2>
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="button">
        {{ section.settings.cta_label | default: 'Shop the collection' }}
      </a>
    </div>
  </div>
</article>

{% stylesheet %}
  {%- comment -%} Hero Section {%- endcomment -%}
  .sf-craft-page__hero--with-image {
    min-height: 60vh;
    overflow: hidden;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sf-craft-page__hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .sf-craft-page__hero--with-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(20, 20, 19, 0.4) 0%, rgba(20, 20, 19, 0.35) 100%);
    z-index: 1;
  }
  .sf-craft-page__hero--with-image .sf-craft-page__hero-overlay {
    position: relative;
    z-index: 2;
    padding: 96px 24px;
  }

  {%- comment -%} Intro Section {%- endcomment -%}
  .sf-craft-page__intro {
    padding: 3rem 2rem;
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }
  .sf-craft-page__intro p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-foreground);
  }

  {%- comment -%} Pillars Section {%- endcomment -%}
  .sf-craft-page__pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding: 2rem;
  }
  .sf-craft-pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sf-craft-pillar__icon {
    width: 80px;
    height: 80px;
    margin-bottom: 1rem;
    color: var(--sf-primary, #2B3A2E);
  }
  .sf-craft-pillar__icon svg path,
  .sf-craft-pillar__icon svg circle {
    transition: stroke-width 0.4s cubic-bezier(0.25, 1, 0.5, 1), stroke 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .sf-craft-pillar:hover .sf-craft-pillar__icon svg path,
  .sf-craft-pillar:hover .sf-craft-pillar__icon svg circle {
    stroke-width: 1.5;
    stroke: var(--sf-primary, #2B3A2E);
  }
  .sf-craft-pillar__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-foreground);
  }
  .sf-craft-pillar__body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground);
    opacity: 0.9;
  }

  {%- comment -%} Standards Section — Split Screen Layout {%- endcomment -%}
  .sf-craft-page__standards {
    background: transparent;
  }
  .sf-standards-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 3rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .sf-standards-text-col {
    display: flex;
    flex-direction: column;
  }
  .sf-quality__head {
    margin-bottom: 2rem;
  }
  .sf-quality__head .sf-eyebrow--light {
    color: var(--sf-primary, #2B3A2E);
    margin-bottom: 0.5rem;
  }
  .sf-quality__head h2 {
    font-size: 2rem;
    line-height: 1.2;
    color: var(--color-foreground);
    font-weight: 300;
    letter-spacing: 0.02em;
  }
  .sf-craft-page__standards-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sf-craft-page__standard {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .sf-craft-page__standard-num {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--sf-primary, #2B3A2E);
    min-width: 2.5rem;
    flex-shrink: 0;
  }
  .sf-craft-page__standard p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground);
    margin: 0;
  }

  {%- comment -%} Standards Side Image {%- endcomment -%}
  .sf-standards-image-col {
    position: relative;
    overflow: hidden;
  }
  .sf-standards-image-wrapper {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sf-standards-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  {%- comment -%} CTA Section with Background {%- endcomment -%}
  .sf-craft-page__cta {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .sf-craft-page__cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }
  .sf-cta-box {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    background: transparent;
    padding: 0;
  }
  .sf-cta-box h2 {
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
  }
  .sf-cta-box .button {
    display: inline-block;
    padding: 12px 32px;
    background: var(--sf-primary, #2B3A2E);
    color: var(--sf-base, #EBE4D6);
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  .sf-cta-box .button:hover {
    background: var(--sf-base, #EBE4D6);
    color: var(--sf-primary, #2B3A2E);
  }

  {%- comment -%} Premium Luxury Animation {%- endcomment -%}
  [data-sf-reveal] {
    animation: luxuryReveal 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  @keyframes luxuryReveal {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  {%- comment -%} Responsive Design {%- endcomment -%}
  @media (max-width: 768px) {
    .sf-standards-container {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1rem;
    }
    .sf-craft-page__pillars {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
    .sf-quality__head h2 {
      font-size: 1.5rem;
    }
    .sf-craft-page__cta {
      min-height: 300px;
      padding: 2rem 1rem;
    }
    .sf-cta-box h2 {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF Craft & Quality",
  "tag": "section",
  "class": "sf-craft-page-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Premium luxury overlay with subtle charcoal gradient applied. Dimensions: 2400×1600 recommended for optimal lookbook aesthetic." },
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "What we put into every piece." },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph" },
    { "type": "header", "content": "Standards section" },
    { "type": "text", "id": "standards_eyebrow", "label": "Standards eyebrow" },
    { "type": "text", "id": "standards_heading", "label": "Standards heading" },
    { "type": "textarea", "id": "standards", "label": "Standards (pipe-separated)", "info": "Separate each point with | character" },
    { "type": "image_picker", "id": "standards_side_image", "label": "Standards Lookbook Image", "info": "Split-screen image for standards section. Aspect ratio 4:5 recommended (e.g., 600×750px)" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading" },
    { "type": "text", "id": "cta_label", "label": "CTA button label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "image_picker", "id": "cta_bg_image", "label": "CTA Background Image", "info": "Full-bleed background for CTA section. Soft dark overlay applied for text legibility. Dimensions: 1200×600 recommended" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Quality Pillar",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "yarn",   "label": "Yarn ball" },
          { "value": "gauge",  "label": "Gauge clock" },
          { "value": "hand",   "label": "Hand" },
          { "value": "fibre",  "label": "Fibre" }
        ], "default": "yarn" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "SF Craft & Quality",
      "category": "Stitch Fit",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "fibre",  "title": "Long-staple Fibres",  "body": "We source yarns chosen for staple length — the longer the fibre, the softer and more durable the knit. No shortcuts in the raw material." } },
        { "type": "pillar", "settings": { "icon": "gauge",  "title": "True Gauge Knitting",  "body": "Every style is knit at the gauge it was designed for. The right machine, the right stitch count. Your knitwear holds its shape." } },
        { "type": "pillar", "settings": { "icon": "hand",   "title": "Hand Finished",        "body": "Every seam is linked by hand. Every piece inspected before it ships. Not a robot. A person who cares about the result." } },
        { "type": "pillar", "settings": { "icon": "yarn",   "title": "Pre-washed",           "body": "All garments are pre-washed before leaving our floor. What you receive is the finished size. No unpleasant surprises." } }
      ]
    }
  ]
}
{% endschema %}
