{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_title   = product.title
  assign product_desc    = product.description
  assign featured_image  = current_variant.featured_image | default: product.featured_image

  assign has_compare     = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare = true
  endif

  assign color_option_index = nil
  for opt in product.options_with_values
    assign opt_lower = opt.name | downcase
    if opt_lower == 'color' or opt_lower == 'colour'
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

<section
  class="sf-pdp"
  id="sf-pdp-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
>

  {%- comment -%} Breadcrumb {%- endcomment -%}
  <nav class="sf-pdp__breadcrumb" aria-label="Breadcrumb">
    <ol class="sf-pdp__breadcrumb-list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if product.collections.size > 0 -%}
        {%- assign bc_col = product.collections.first -%}
        <li aria-hidden="true">/</li>
        <li><a href="{{ bc_col.url }}">{{ bc_col.title }}</a></li>
      {%- endif -%}
      <li aria-hidden="true">/</li>
      <li aria-current="page">{{ product_title }}</li>
    </ol>
  </nav>

  <div class="sf-pdp__grid">

    {%- comment -%}══════════════ LEFT — GALLERY ══════════════{%- endcomment -%}
    <div class="sf-pdp__gallery" data-sf-reveal>

      {%- comment -%} Vertical thumbnail strip — always shown, padded to ≥4 slots {%- endcomment -%}
      {%- assign media_count = product.media.size -%}
      {%- assign thumb_min   = 4 -%}
      {%- assign pad_count   = 0 -%}
      {%- if media_count < thumb_min -%}
        {%- assign pad_count = thumb_min | minus: media_count -%}
      {%- endif -%}
      {%- assign fi_src    = product.featured_image | image_url: width: 160 -%}
      {%- assign fi_main   = product.featured_image | image_url: width: 1200 -%}
      {%- assign fi_full   = product.featured_image | image_url: width: 1800 -%}
      {%- assign fi_600    = product.featured_image | image_url: width: 600 -%}
      {%- assign fi_srcset = fi_600 | append: ' 600w, ' | append: fi_main | append: ' 1200w, ' | append: fi_full | append: ' 1800w' -%}

      <div class="sf-pdp__gallery-thumbs" role="list" aria-label="Product images" data-sf-stagger>
        {%- for media in product.media limit: 8 -%}
          <button
            class="sf-pdp__thumb{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-thumb-index="{{ forloop.index0 }}"
            data-src="{{ media | image_url: width: 1200 }}"
            data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
            data-full="{{ media | image_url: width: 1800 }}"
            data-alt="{{ media.alt | default: product_title | escape }}"
            aria-label="Image {{ forloop.index }} of {{ product.media.size }}"
            role="listitem"
          >
            <img
              src="{{ media | image_url: width: 160 }}"
              alt="{{ media.alt | default: product_title | escape }}"
              width="80"
              height="80"
              loading="lazy">
          </button>
        {%- endfor -%}

        {%- if pad_count > 0 -%}
          {%- for i in (1..pad_count) -%}
            <button
              class="sf-pdp__thumb sf-pdp__thumb--pad"
              type="button"
              data-thumb-index="{{ media_count | plus: forloop.index0 }}"
              data-src="{{ fi_main }}"
              data-srcset="{{ fi_srcset }}"
              data-full="{{ fi_full }}"
              data-alt="{{ product_title | escape }}"
              aria-label="Product view {{ forloop.index }}"
              role="listitem"
            >
              <img
                src="{{ fi_src }}"
                alt=""
                width="80"
                height="80"
                loading="lazy">
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} Main image {%- endcomment -%}
      <div class="sf-pdp__gallery-main" id="sf-pdp-main-{{ section.id }}">
        {%- if featured_image != blank -%}
          <button
            type="button"
            class="sf-pdp__main-zoom-trigger"
            aria-label="Zoom image"
            data-full="{{ featured_image | image_url: width: 1800 }}"
          >
            <img
              id="sf-pdp-main-img-{{ section.id }}"
              class="sf-pdp__main-img"
              src="{{ featured_image | image_url: width: 1200 }}"
              srcset="{{ featured_image | image_url: width: 600 }} 600w,
                      {{ featured_image | image_url: width: 1200 }} 1200w,
                      {{ featured_image | image_url: width: 1800 }} 1800w"
              sizes="(max-width: 768px) 100vw, 50vw"
              width="{{ featured_image.width }}"
              height="{{ featured_image.height }}"
              alt="{{ featured_image.alt | default: product_title | escape }}"
              loading="eager"
              fetchpriority="high">
            <span class="sf-pdp__zoom-hint" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </button>
        {%- else -%}
          <div class="sf-pdp__main-img sf-pdp__main-img--placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%}══════════════ RIGHT — DETAILS ══════════════{%- endcomment -%}
    <div class="sf-pdp__details" data-sf-reveal data-sf-stagger>

      <h1 class="sf-pdp__title">{{ product_title }}</h1>

      {%- if product_desc != blank -%}
        <p class="sf-pdp__excerpt">{{ product_desc | strip_html | truncate: 140 }}</p>
      {%- endif -%}

      {%- comment -%} Static rating only if metafield set {%- endcomment -%}
      {%- assign rating_val = product.metafields.reviews.rating.value.rating | default: 0 | times: 1.0 -%}
      {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- if rating_val > 0 and rating_count > 0 -%}
        <div class="sf-pdp__rating" aria-label="{{ rating_val }} out of 5 stars, {{ rating_count }} reviews">
          {%- for i in (1..5) -%}
            {%- if i <= rating_val -%}
              <svg class="sf-pdp__star sf-pdp__star--full" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {%- else -%}
              <svg class="sf-pdp__star sf-pdp__star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {%- endif -%}
          {%- endfor -%}
          <span class="sf-pdp__rating-count">({{ rating_count }})</span>
        </div>
      {%- endif -%}

      {%- comment -%} Price {%- endcomment -%}
      <div class="sf-pdp__price-wrap">
        {%- if has_compare -%}
          <span class="sf-pdp__price sf-pdp__price--sale" id="sf-pdp-price-current">{{ current_variant.price | money }}</span>
          <span class="sf-pdp__price sf-pdp__price--compare" id="sf-pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- assign pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="sf-pdp__badge">{{ pct }}% OFF</span>
        {%- else -%}
          <span class="sf-pdp__price" id="sf-pdp-price-current">{{ current_variant.price | money }}</span>
          <span class="sf-pdp__price sf-pdp__price--compare" id="sf-pdp-price-compare" style="display:none;"></span>
        {%- endif -%}
      </div>

      {%- comment -%} Variant options {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="sf-pdp__variants">
          {%- for option in product.options_with_values -%}
            {%- assign opt_lower = option.name | downcase -%}
            {%- assign is_color = false -%}
            {%- if opt_lower == 'color' or opt_lower == 'colour' -%}
              {%- assign is_color = true -%}
            {%- endif -%}

            <div class="sf-pdp__option" data-option-index="{{ forloop.index0 }}">
              <div class="sf-pdp__option-header">
                <span class="sf-pdp__option-label">
                  {{ option.name }}:
                  <strong class="sf-pdp__option-selected" id="sf-opt-val-{{ section.id }}-{{ forloop.index0 }}">{{ option.selected_value }}</strong>
                </span>
                {%- if opt_lower == 'size' -%}
                  <button type="button" class="sf-pdp__size-guide-trigger" aria-haspopup="dialog" aria-controls="sf-size-modal-{{ section.id }}">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="6" width="16" height="8" rx="1"/><path d="M5 6V4M8 6V4M11 6V4M14 6V4"/></svg>
                    Size Guide
                  </button>
                {%- endif -%}
              </div>

              <div class="sf-pdp__option-values{% if is_color %} sf-pdp__option-values--swatches{% endif %}">
                {%- for value in option.values -%}
                  {%- assign is_selected = false -%}
                  {%- if value == option.selected_value -%}{%- assign is_selected = true -%}{%- endif -%}

                  {%- if is_color -%}
                    {%- assign swatch_color = value.swatch.color -%}
                    {%- if swatch_color == blank -%}
                      {%- assign swatch_color = value | handle | replace: '-', '' -%}
                    {%- endif -%}
                    <button type="button" class="sf-pdp__swatch{% if is_selected %} is-selected{% endif %}"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                      aria-label="{{ option.name }}: {{ value }}"
                      aria-pressed="{{ is_selected }}"
                      title="{{ value }}"
                      style="background-color: {{ swatch_color }};"></button>
                  {%- else -%}
                    <button type="button" class="sf-pdp__pill{% if is_selected %} is-selected{% endif %}"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                      aria-label="{{ option.name }}: {{ value }}"
                      aria-pressed="{{ is_selected }}">{{ value }}</button>
                  {%- endif -%}

                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%} Decorative colour fallback (no real Color option exists) {%- endcomment -%}
      {%- if color_option_index == nil -%}
        <div class="sf-pdp__option sf-pdp__option--decorative">
          <div class="sf-pdp__option-header">
            <span class="sf-pdp__option-label">
              Available in: <strong id="sf-deco-color-{{ section.id }}">White</strong>
              <span class="sf-pdp__option-note">visual reference</span>
            </span>
          </div>
          <div class="sf-pdp__option-values sf-pdp__option-values--swatches">
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative is-selected" data-deco-color="White"  aria-label="White (visual reference)"  style="background-color:#F5F1E8;"></button>
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative" data-deco-color="Grey"   aria-label="Grey (visual reference)"   style="background-color:#9CA0A1;"></button>
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative" data-deco-color="Black"  aria-label="Black (visual reference)"  style="background-color:#1A1F1B;"></button>
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative" data-deco-color="Navy"   aria-label="Navy (visual reference)"   style="background-color:#1B2A4E;"></button>
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative" data-deco-color="Brown"  aria-label="Brown (visual reference)"  style="background-color:#5C3D2E;"></button>
            <button type="button" class="sf-pdp__swatch sf-pdp__swatch--decorative" data-deco-color="Tan"    aria-label="Tan (visual reference)"    style="background-color:#C8A576;"></button>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Stock indicator {%- endcomment -%}
      <p class="sf-pdp__stock" id="sf-pdp-stock-{{ section.id }}"
        {%- unless current_variant.available -%}data-state="sold-out"{%- else -%}{%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 -%}data-state="low"{%- else -%}data-state="ok"{%- endif -%}{%- endunless -%}>
        {%- unless current_variant.available -%}
          Sold out
        {%- else -%}
          {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 -%}
            Only {{ current_variant.inventory_quantity }} left in stock
          {%- else -%}
            In stock — ships in 2–3 days
          {%- endif -%}
        {%- endunless -%}
      </p>

      {%- comment -%} Buy form {%- endcomment -%}
      <form
        action="{{ routes.cart_add_url }}"
        method="post"
        enctype="multipart/form-data"
        class="sf-pdp__form"
        id="sf-pdp-form-{{ section.id }}"
        novalidate
      >
        <input type="hidden" name="id" id="sf-pdp-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

        <div class="sf-pdp__buy-row">
          <div class="sf-pdp__qty" role="group" aria-label="Quantity">
            <button type="button" class="sf-pdp__qty-btn" data-action="decrement" aria-label="Decrease quantity">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="4" y="9" width="12" height="2" rx="1"/></svg>
            </button>
            <input type="number" name="quantity" id="sf-pdp-qty-{{ section.id }}" class="sf-pdp__qty-input" value="1" min="1" max="99" aria-label="Quantity">
            <button type="button" class="sf-pdp__qty-btn" data-action="increment" aria-label="Increase quantity">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 4a1 1 0 011 1v4h4a1 1 0 010 2h-4v4a1 1 0 01-2 0v-4H5a1 1 0 010-2h4V5a1 1 0 011-1z"/></svg>
            </button>
          </div>

          <button type="submit" class="sf-pdp__atc" id="sf-pdp-atc-{{ section.id }}"
            {%- unless current_variant.available -%} disabled aria-disabled="true"{%- endunless -%}>
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'Add to Cart' }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </div>

        <button type="button" class="sf-pdp__buy-now" id="sf-pdp-buy-now-{{ section.id }}"
          {%- unless current_variant.available -%} disabled aria-disabled="true"{%- endunless -%}>
          {{ section.settings.buy_now_label | default: 'Buy Now' }}
        </button>
      </form>

      {%- comment -%} Info cards {%- endcomment -%}
      <div class="sf-pdp__info-cards">
        <div class="sf-pdp__info-card">
          <div class="sf-pdp__info-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div>
            <p class="sf-pdp__info-card-heading">{{ section.settings.card1_heading | default: 'Free Delivery' }}</p>
            <p class="sf-pdp__info-card-body">
              {{ section.settings.card1_body | default: 'Enter your Postal Code for Delivery Availability' }}
              {%- if section.settings.card1_link != blank -%}
                <a href="{{ section.settings.card1_link }}" class="sf-pdp__info-card-link">{{ section.settings.card1_link_label | default: 'Check' }}</a>
              {%- endif -%}
            </p>
          </div>
        </div>

        <div class="sf-pdp__info-card">
          <div class="sf-pdp__info-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14l-4-4 4-4"/><path d="M5 10h11a4 4 0 010 8h-1"/></svg>
          </div>
          <div>
            <p class="sf-pdp__info-card-heading">{{ section.settings.card2_heading | default: 'Return Delivery' }}</p>
            <p class="sf-pdp__info-card-body">
              {{ section.settings.card2_body | default: 'Free 14-day Delivery Returns.' }}
              {%- if section.settings.card2_link != blank -%}
                <a href="{{ section.settings.card2_link }}" class="sf-pdp__info-card-link">{{ section.settings.card2_link_label | default: 'Details' }}</a>
              {%- endif -%}
            </p>
          </div>
        </div>
      </div>

    </div>{%- comment -%} end .sf-pdp__details {%- endcomment -%}
  </div>{%- comment -%} end .sf-pdp__grid {%- endcomment -%}

  {%- comment -%}══════════════ FULL-WIDTH TABS ══════════════{%- endcomment -%}
  <div class="sf-pdp__info-section" data-sf-reveal>
    <div class="sf-pdp__tabs" role="tablist" aria-label="Product information">
      <button type="button" class="sf-pdp__tab is-active" role="tab" aria-selected="true"  data-tab="description">Description</button>
      <button type="button" class="sf-pdp__tab"            role="tab" aria-selected="false" data-tab="fabric">Fabric &amp; Care</button>
      <button type="button" class="sf-pdp__tab"            role="tab" aria-selected="false" data-tab="shipping">Shipping</button>
      <button type="button" class="sf-pdp__tab"            role="tab" aria-selected="false" data-tab="returns">Returns &amp; Exchanges</button>
    </div>

    <div class="sf-pdp__tab-panels">
      <div class="sf-pdp__tab-panel is-active" role="tabpanel" data-panel="description">
        <div class="rte">{{ product_desc }}</div>
      </div>
      <div class="sf-pdp__tab-panel" role="tabpanel" data-panel="fabric">
        {%- if section.settings.fabric_care != blank -%}
          {{ section.settings.fabric_care }}
        {%- else -%}
          <p>Premium knitwear, finished by hand in Gujranwala.</p>
          <ul>
            <li>Wash cold (max 30°C), inside out, with similar colours.</li>
            <li>Lay flat to dry — avoid direct sunlight.</li>
            <li>Do not bleach. Cool iron if needed.</li>
            <li>Steam to refresh between wears; dry-clean when in doubt.</li>
          </ul>
        {%- endif -%}
      </div>
      <div class="sf-pdp__tab-panel" role="tabpanel" data-panel="shipping">
        {%- if section.settings.shipping_info != blank -%}
          {{ section.settings.shipping_info }}
        {%- else -%}
          <p>We ship across Pakistan and worldwide.</p>
          <ul>
            <li>Orders ship in <strong>2–3 business days</strong> from Gujranwala.</li>
            <li><strong>Free domestic shipping</strong> on orders over PKR 10,000.</li>
            <li>International rates calculated at checkout.</li>
            <li>Tracking link sent by email and SMS once dispatched.</li>
          </ul>
          <p><a href="/pages/shipping">Full shipping policy →</a></p>
        {%- endif -%}
      </div>
      <div class="sf-pdp__tab-panel" role="tabpanel" data-panel="returns">
        {%- if section.settings.returns_info != blank -%}
          {{ section.settings.returns_info }}
        {%- else -%}
          <p>We want you to love what you wear.</p>
          <ul>
            <li>14-day returns on unworn items with tags attached.</li>
            <li>Free exchanges for size/colour within Pakistan.</li>
            <li>Refunds processed within 5–7 business days of receipt.</li>
          </ul>
          <p><a href="/pages/returns-exchanges">Return &amp; exchange policy →</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}══════════════ SIZE GUIDE MODAL ══════════════{%- endcomment -%}
  <dialog class="sf-pdp__size-modal" id="sf-size-modal-{{ section.id }}" aria-label="Size Guide" aria-modal="true">
    <div class="sf-pdp__size-modal-inner">
      <div class="sf-pdp__size-modal-header">
        <div>
          <h2 class="sf-pdp__size-modal-title">Size Guide</h2>
          <p class="sf-pdp__size-modal-helper">Find your perfect fit — measurements in cm</p>
        </div>
        <button class="sf-pdp__size-modal-close" aria-label="Close size guide" type="button">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
        </button>
      </div>

      {%- if section.settings.size_guide_content != blank -%}
        <div class="sf-pdp__size-modal-intro rte">{{ section.settings.size_guide_content }}</div>
      {%- endif -%}

      <div class="sf-pdp__size-modal-body">
        <table class="sf-pdp__size-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Chest</th>
              <th scope="col">Waist</th>
              <th scope="col">Hips</th>
              <th scope="col">Length</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">XS</th>  <td>82–87</td>   <td>63–68</td>   <td>87–92</td>    <td>66</td></tr>
            <tr><th scope="row">S</th>   <td>87–92</td>   <td>68–73</td>   <td>92–97</td>    <td>68</td></tr>
            <tr><th scope="row">M</th>   <td>92–97</td>   <td>73–78</td>   <td>97–102</td>   <td>70</td></tr>
            <tr><th scope="row">L</th>   <td>97–102</td>  <td>78–83</td>   <td>102–107</td>  <td>72</td></tr>
            <tr><th scope="row">XL</th>  <td>102–107</td> <td>83–88</td>   <td>107–112</td>  <td>74</td></tr>
            <tr><th scope="row">XXL</th> <td>107–112</td> <td>88–93</td>   <td>112–117</td>  <td>76</td></tr>
          </tbody>
        </table>
        <p class="sf-pdp__size-modal-tip">
          <strong>Between sizes?</strong> Size down for a closer fit, up for a softer drape.
        </p>
      </div>
    </div>
  </dialog>

  {%- comment -%}══════════════ IMAGE LIGHTBOX ══════════════{%- endcomment -%}
  <dialog class="sf-pdp__lightbox" id="sf-lightbox-{{ section.id }}" aria-label="Image viewer">
