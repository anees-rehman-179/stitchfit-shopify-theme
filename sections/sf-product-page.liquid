    </button>
    <button class="sf-pdp__lightbox-nav sf-pdp__lightbox-nav--prev" aria-label="Previous image" type="button">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M12.79 5.23a.75.75 0 010 1.06L9.06 10l3.73 3.71a.75.75 0 11-1.06 1.06l-4.25-4.24a.75.75 0 010-1.06l4.25-4.24a.75.75 0 011.06 0z"/></svg>
    </button>
