{%- liquid
  assign active_handle = collection.handle | default: 'all'
-%}

<div class="sf-catalog-header">
  <div class="sf-catalog-header__hero">
    <span class="sf-eyebrow sf-eyebrow--banner">{{ section.settings.eyebrow | default: 'The Collection' }}</span>
    <h1 class="sf-catalog-header__title">{{ section.settings.heading | default: 'Shop All' }}</h1>
    {%- if section.settings.subhead != blank -%}
      <p class="sf-catalog-header__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}
  </div>

  <nav class="sf-catalog-pills" aria-label="{{ section.settings.nav_label | default: 'Shop by category' }}">
    <ul class="sf-catalog-pills__list" role="list">
      <li class="sf-catalog-pills__item">
        <a href="{{ routes.all_products_collection_url }}"
          class="sf-catalog-pill{% if active_handle == 'all' %} sf-catalog-pill--active{% endif %}"
          {% if active_handle == 'all' %}aria-current="page"{% endif %}>
          All
        </a>
      </li>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category_pill' and block.settings.handle != blank -%}
          <li class="sf-catalog-pills__item">
            <a href="{{ routes.collections_url }}/{{ block.settings.handle }}"
              class="sf-catalog-pill{% if active_handle == block.settings.handle %} sf-catalog-pill--active{% endif %}"
              {% if active_handle == block.settings.handle %}aria-current="page"{% endif %}
              {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.handle | replace: '-', ' ' | capitalize }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
</div>

{% stylesheet %}
  .sf-catalog-header {
    background: var(--sf-primary, #2B3A2E);
    padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 60px) 0;
  }

  .sf-catalog-header__hero {
    text-align: center;
    padding-bottom: clamp(32px, 4vw, 48px);
  }

  .sf-catalog-header__title {
    font-family: var(--sf-font-display, 'Canela', Georgia, serif);
    font-weight: 300;
    font-size: clamp(36px, 5vw, 56px);
    letter-spacing: 0.04em;
    color: var(--sf-base, #EBE4D6);
    margin: 8px 0 0;
    line-height: 1.1;
  }

  .sf-catalog-header__subhead {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(235, 228, 214, 0.72);
    max-width: 60ch;
    margin: 12px auto 0;
  }

  .sf-catalog-pills {
    border-top: 1px solid rgba(235, 228, 214, 0.12);
    padding: 0 clamp(20px, 5vw, 60px);
    overflow: hidden;
  }

  .sf-catalog-pills__list {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 20px 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .sf-catalog-pills__list::-webkit-scrollbar {
    display: none;
  }

  .sf-catalog-pills__item {
    flex-shrink: 0;
  }

  .sf-catalog-pill {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1.5px solid var(--sf-accent, #A8754C);
    color: var(--sf-base, #EBE4D6);
    font-family: var(--sf-font-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, color 200ms ease;
  }

  .sf-catalog-pill:hover,
  .sf-catalog-pill:focus-visible {
    background: var(--sf-accent, #A8754C);
    color: var(--sf-base, #EBE4D6);
    outline: 2px solid var(--sf-accent, #A8754C);
    outline-offset: 2px;
  }

  .sf-catalog-pill--active {
    background: var(--sf-accent, #A8754C);
    color: var(--sf-base, #EBE4D6);
  }

  @media (prefers-reduced-motion: reduce) {
    .sf-catalog-pill {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SF Catalog Header",
  "tag": "section",
  "class": "sf-catalog-header-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Every piece, one place."
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigation aria-label",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category_pill",
      "name": "Category pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "placeholder": "Polo Shirts"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle",
          "placeholder": "polo-shirts",
          "info": "The collection's URL handle (e.g. polo-shirts)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SF Catalog Header",
      "category": "Stitch Fit",
      "blocks": [
        { "type": "category_pill", "settings": { "label": "Polo Shirts",          "handle": "polo-shirts" } },
        { "type": "category_pill", "settings": { "label": "Sweaters & Pullovers", "handle": "sweaters-pullovers" } },
        { "type": "category_pill", "settings": { "label": "Cardigans",            "handle": "cardigans" } },
        { "type": "category_pill", "settings": { "label": "T-Shirts & Henleys",   "handle": "t-shirts-henleys" } }
      ]
    }
  ]
}
{% endschema %}
