<section class="sf-categories" data-sf-reveal>
  <div class="sf-categories__head">
    <div class="sf-eyebrow">{{ section.settings.eyebrow | default: 'The Range' }}</div>
    <h2 class="sf-categories__title">{{ section.settings.title | default: 'Shop by category' }}</h2>
  </div>

  <div class="sf-categories__grid">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '/collections/all' }}"
        class="sf-category-card"
        data-sf-reveal
        {{ block.shopify_attributes }}>
        <div class="sf-category-card__media">
          {%- if block.settings.image -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ block.settings.title | escape }}">
          {%- else -%}
            {% render 'sf-placeholder', label: block.settings.title | default: 'CATEGORY' | upcase, ratio: '4/5' %}
          {%- endif -%}
        </div>
        <div class="sf-category-card__body">
          <span class="sf-category-card__label">{{ block.settings.title }}</span>
          <span class="sf-category-card__arrow" aria-hidden="true">→</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Stitch Fit Categories",
  "tag": "section",
  "class": "sf-categories-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Range" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category name" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link to collection" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Stitch Fit Categories",
      "category": "Stitch Fit",
      "blocks": [
        { "type": "category", "settings": { "title": "Polo Shirts" } },
        { "type": "category", "settings": { "title": "Sweaters & Pullovers" } },
        { "type": "category", "settings": { "title": "Cardigans" } },
        { "type": "category", "settings": { "title": "T-Shirts & Henleys" } }
      ]
    }
  ]
}
{% endschema %}
