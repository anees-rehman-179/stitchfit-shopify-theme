{%- doc -%}
  Stitch Fit placeholder.
  Usage:
    {% render 'sf-placeholder', label: 'HERO-VIDEO', ratio: '16/9', kind: 'video' %}

  @param {string} [label] - Short uppercase tag shown to the client
  @param {string} [ratio] - CSS aspect-ratio, e.g. '4/5', '16/9', '1/1', '3/4'
  @param {string} [kind]  - 'image' (default) or 'video'
{%- enddoc -%}

{%- assign placeholder_ratio = ratio | default: '4/5' -%}
{%- assign placeholder_kind  = kind  | default: 'image' -%}
{%- assign placeholder_label = label | default: 'IMAGE' -%}

<div class="sf-placeholder sf-placeholder--{{ placeholder_kind }}" style="aspect-ratio: {{ placeholder_ratio }};">
  <div class="sf-placeholder__inner">
    <span class="sf-placeholder__icon" aria-hidden="true">
      {%- if placeholder_kind == 'video' -%}▶{%- else -%}◧{%- endif -%}
    </span>
    <span class="sf-placeholder__label">{{ placeholder_label }}</span>
    <span class="sf-placeholder__ratio">{{ placeholder_ratio }}</span>
  </div>
</div>
